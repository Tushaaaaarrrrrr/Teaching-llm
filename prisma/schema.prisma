generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                 @id @default(cuid())
  name                    String
  firstName               String?
  lastName                String?
  mobileNumber            String?
  email                   String                 @unique
  passwordHash            String
  role                    String                 @default("STUDENT")
  avatar                  String?
  securityNumber          String?                @unique
  isTerminated            Boolean                @default(false)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  canCreateStudents       Boolean                @default(false)
  canTerminate            Boolean                @default(false)
  gender                  String?                
  genderChangedAt         DateTime?
  age                     Int?
  state                   String?
  isProfileComplete       Boolean                @default(false)
  blockedUntil            DateTime?
  hasSeenWelcome          Boolean                @default(false)
  isSuperManager          Boolean                @default(false)
  lastSeenCommunityAt     DateTime?
  lastSeenNotificationsAt DateTime?
  lastSeenSupportAt       DateTime?
  lastViolationAt         DateTime?
  tokenVersion            Int                    @default(0)
  violationCount          Int                    @default(0)
  isGoogleUser            Boolean                @default(false)
  encryptedTempPassword   String?
  lastDailyDigestAt       DateTime?
  activityLogs            ActivityLog[]
  announcements           Announcement[]         @relation("AnnouncementCreator")
  chatMessages            ChatMessage[]          @relation("ChatMsgSender")
  agentSessions           ChatSession[]          @relation("ChatAgent")
  chatSessions            ChatSession[]          @relation("ChatStudent")
  createdCourses          Course[]               @relation("CourseCreator")
  comments                Comment[]
  communityMessages       CommunityMessage[]     @relation("CommMsgSender")
  courseEvents            CourseEvent[]          @relation("EventCreator")
  createdCourseBundles    CourseBundle[]         @relation("BundleCreator")
  instructorCourseEvents  CourseEvent[]          @relation("EventInstructor")
  syncedSessionEvents     DailySessionSnapshot[] @relation("SnapshotInstructor")
  enrollments             Enrollment[]
  feedbacks               Feedback[]
  instructorAssignments   InstructorAssignment[]
  courseBundleAssignments UserCourseBundleAssignment[]
  uploadedLectures        Lecture[]              @relation("LectureUploader")
  loginLogs               LoginLog[]
  uploadedMaterials       Material[]             @relation("MaterialUploader")
  notifications           Notification[]
  assignedTickets         SupportTicket[]        @relation("TicketAssignee")
  supportTickets          SupportTicket[]        @relation("TicketStudent")
  createdUpdates          SystemUpdate[]         @relation("UpdateCreator")
  ticketReplies           TicketReply[]          @relation("ReplyAuthor")
  updateViews             UpdateView[]
  lectureProgress         LectureProgress[]
  communityReadStates     CommunityReadState[]
}

model Course {
  id                    String                 @id @default(cuid())
  name                  String
  description           String?
  subject               String?
  googleGroupEmail      String?
  color                 String                 @default("#4F46E5")
  icon                  String                 @default("BookOpen")
  createdById           String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  expiresAt             DateTime?
  isCommunityActive     Boolean                @default(true)
  isDisabled            Boolean                @default(false)
  isDemo                Boolean                @default(false)
  isFree                Boolean                @default(false)
  isGlobal              Boolean                @default(false)
  lastMessageAt         DateTime?
  teacherName           String?
  announcements         Announcement[]
  createdBy             User                   @relation("CourseCreator", fields: [createdById], references: [id])
  communityMessages     CommunityMessage[]
  courseEvents          CourseEvent[]
  dailySessionSnapshots DailySessionSnapshot[]
  courseBundles         CourseBundleCourse[]
  enrollments           Enrollment[]
  exams                 Exam[]
  feedbacks             Feedback[]
  instructorAssignments InstructorAssignment[]
  lectures              Lecture[]
  materials             Material[]
  supportTickets        SupportTicket[]
  topics                Topic[]
  groupSyncJobs         GroupSyncJob[]
  communityReadStates   CommunityReadState[]

  @@index([lastMessageAt])
  @@map("Class")
}

enum EnrollmentType {
  LIVE
  RECORDED
}

model Enrollment {
  id               String         @id @default(cuid())
  userId           String
  courseId         String         @map("classId")
  isFreeEnrollment Boolean        @default(false)
  type             EnrollmentType @default(LIVE)
  createdAt        DateTime       @default(now())
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model CourseBundle {
  id              String                      @id @default(cuid())
  name            String
  description     String?
  createdById     String
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  createdBy       User                        @relation("BundleCreator", fields: [createdById], references: [id])
  courses         CourseBundleCourse[]
  userAssignments UserCourseBundleAssignment[]

  @@unique([createdById, name])
}

model CourseBundleCourse {
  id        String       @id @default(cuid())
  bundleId  String
  courseId  String       @map("classId")
  bundle    CourseBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([bundleId, courseId])
  @@index([bundleId])
  @@index([courseId])
}

model UserCourseBundleAssignment {
  id           String       @id @default(cuid())
  userId       String
  bundleId     String
  assignedById String?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bundle       CourseBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([userId, bundleId])
  @@index([userId])
  @@index([bundleId])
}

model Lecture {
  id           String   @id @default(cuid())
  courseId     String   @map("classId")
  title        String
  description  String?
  videoUrl     String?
  notesUrl     String?
  duration     String?
  thumbnail    String?
  uploadedById String
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("LectureUploader", fields: [uploadedById], references: [id])

  @@index([courseId])
  @@index([uploadedById])
}

model Material {
  id           String   @id @default(cuid())
  courseId     String?  @map("classId")
  title        String
  description  String?
  fileUrl      String      // URL to file (either uploaded file or external link)
  fileType     String      // Original file type (pdf, docx, etc.) or "link"
  fileSize     String?
  sourceType   String   @default("FILE")  // "FILE" for uploads, "LINK" for external links
  uploadedById String
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isGlobal     Boolean  @default(false)
  isFree       Boolean  @default(false)
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("MaterialUploader", fields: [uploadedById], references: [id])

  @@index([courseId])
  @@index([uploadedById])
}

model CourseEvent {
  id                String    @id @default(cuid())
  courseId          String?   @map("classId")
  title             String
  description       String?
  startTime         DateTime
  endTime           DateTime
  meetLink          String?
  status            String    @default("SCHEDULED") // SCHEDULED, CANCELLED, RESCHEDULED
  type              String    @default("class") // class, exam, assignment, introduction, holiday, etc.
  isGlobal          Boolean   @default(false)
  originalStartTime DateTime? // For rescheduling
  recurrence        String?   @default("ONETIME") // ONETIME, DAILY, WEEKLY, CUSTOM
  interval          Int?      // For CUSTOM recurrence
  parentId          String?   // For recurring event chain
  instructorId      String?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  course            Course?   @relation(fields: [courseId], references: [id])
  createdBy         User      @relation("EventCreator", fields: [createdById], references: [id])
  instructor        User?     @relation("EventInstructor", fields: [instructorId], references: [id])

  @@index([courseId])
  @@index([startTime])
  @@index([createdById])
  @@index([type])
  @@index([isGlobal])
}

model DailySessionSnapshot {
  id            String   @id @default(cuid())
  snapshotDate  DateTime
  sourceEventId String
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  meetLink      String?
  status        String   @default("SCHEDULED")
  courseId      String?  @map("classId")
  isGlobal      Boolean  @default(false)
  instructorId  String?
  syncedAt      DateTime @default(now())
  createdById   String
  course        Course?  @relation(fields: [courseId], references: [id])
  instructor    User?    @relation("SnapshotInstructor", fields: [instructorId], references: [id])

  @@index([snapshotDate])
  @@index([sourceEventId])
  @@index([courseId])
  @@unique([snapshotDate, sourceEventId])
}


model Topic {
  id        String    @id @default(cuid())
  courseId  String    @map("classId")
  title     String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  content   Content[]
  sharedContentLinks TopicSharedContent[]
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Content {
  id          String    @id @default(cuid())
  topicId     String
  title       String
  description String?
  videoUrl    String?
  pptUrl      String?
  isRecordingOnly Boolean @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  videoSource String    @default("GOOGLE_DRIVE")
  comments    Comment[]
  sharedTopics TopicSharedContent[]
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  lectureProgress LectureProgress[]
}

model TopicSharedContent {
  id        String   @id @default(cuid())
  topicId    String
  contentId  String
  createdAt DateTime @default(now())
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([topicId, contentId])
  @@index([topicId])
  @@index([contentId])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  type        String   @default("info")
  courseId    String?  @map("classId")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String?
  pollId      String?  @unique
  course      Course?  @relation(fields: [courseId], references: [id])
  createdBy   User     @relation("AnnouncementCreator", fields: [createdById], references: [id])
  poll        Poll?    @relation(fields: [pollId], references: [id])
}

model Poll {
  id                String         @id @default(cuid())
  question          String
  expiresAt         DateTime
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  cachedResults     String?
  lastResultsUpdate DateTime?
  announcement      Announcement?
  options           PollOption[]
  responses         PollResponse[]
}

model PollOption {
  id        String         @id @default(cuid())
  pollId    String
  text      String
  order     Int            @default(0)
  poll      Poll           @relation(fields: [pollId], references: [id], onDelete: Cascade)
  responses PollResponse[]
}

model PollResponse {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime   @default(now())
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model Exam {
  id              String         @id @default(cuid())
  externalId      String?        @unique
  title           String
  description     String?
  courseId        String         @map("classId")
  expiresAt       DateTime
  durationMinutes Int
  isPublished     Boolean        @default(false)
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  startDate       DateTime?
  examType        String         @default("FINAL_TEST")
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts        ExamAttempt[]
  questions       ExamQuestion[]

  @@index([courseId])
  @@index([externalId])
}

model ExamQuestion {
  id             String         @id @default(cuid())
  examId         String
  text           String
  type           String
  options        String?
  correctAnswer  String?
  explanation    String?
  marks          Int            @default(1)
  order          Int            @default(0)
  imageUrl       String?
  questionBankId String?
  exam           Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  responses      ExamResponse[]
}

model ExamAttempt {
  id          String         @id @default(cuid())
  examId      String
  userId      String
  startedAt   DateTime       @default(now())
  submittedAt DateTime?
  totalMarks  Float?
  bonusMarks  Float?         @default(0)
  isEvaluated Boolean        @default(false)
  feedback    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  isPublished Boolean        @default(false)
  exam        Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  responses   ExamResponse[]

  @@index([examId])
  @@index([userId])
}

model ExamResponse {
  id         String       @id @default(cuid())
  attemptId  String
  questionId String
  answer     String
  marks      Float?
  feedback   String?
  attempt    ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id           String        @id @default(cuid())
  title        String
  description  String
  type         String        @default("GENERAL")
  status       String        @default("OPEN")
  priority     String        @default("MEDIUM")
  studentId    String
  courseId     String?       @map("classId")
  assignedToId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  assignedTo   User?         @relation("TicketAssignee", fields: [assignedToId], references: [id])
  course       Course?       @relation(fields: [courseId], references: [id])
  user         User          @relation("TicketStudent", fields: [studentId], references: [id])
  replies      TicketReply[]

  @@index([courseId])
  @@index([studentId])
}

model TicketReply {
  id        String        @id @default(cuid())
  ticketId  String
  senderId  String
  content   String
  createdAt DateTime      @default(now())
  sender    User          @relation("ReplyAuthor", fields: [senderId], references: [id])
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String        @id @default(cuid())
  studentId String
  agentId   String?
  status    String        @default("WAITING")
  type      String        @default("SUPPORT")
  expiresAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  agent     User?         @relation("ChatAgent", fields: [agentId], references: [id])
  student   User          @relation("ChatStudent", fields: [studentId], references: [id])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id              String      @id @default(cuid())
  chatId          String
  senderId        String
  content         String
  createdAt       DateTime    @default(now())
  deletedAt       DateTime?
  isDeleted       Boolean     @default(false)
  isSystemDeleted Boolean     @default(false)
  chat            ChatSession @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender          User        @relation("ChatMsgSender", fields: [senderId], references: [id])
}

model CommunityMessage {
  id              String    @id @default(cuid())
  courseId        String    @map("classId")
  senderId        String
  content         String
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  isSystemDeleted Boolean   @default(false)
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sender          User      @relation("CommMsgSender", fields: [senderId], references: [id])

  @@index([courseId])
  @@index([senderId])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  contentId String
  userId    String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lecture   Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([userId])
  @@index([parentId])
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  title          String
  content        String
  type           String   @default("INFO")
  isRead         Boolean  @default(false)
  announcementId String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id                String   @id @default(cuid())
  userId            String
  userName          String
  userRole          String
  securityNumber    String?
  actionType        String
  actionDescription String
  moduleName        String
  targetId          String?
  metadata          String?
  timestamp         DateTime @default(now())
  isFailure         Boolean  @default(false)
  priority          Int      @default(0)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
}

model InstructorAssignment {
  id           String   @id @default(cuid())
  instructorId String
  courseId     String   @map("classId")
  assignedAt   DateTime @default(now())
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor   User     @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([instructorId, courseId])
}

model QuestionBank {
  id            String   @id @default(cuid())
  subject       String
  text          String
  type          String
  options       String?
  correctAnswer String?
  explanation   String?
  imageUrl      String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  marks         Int      @default(1)

  @@index([subject])
}

model SystemUpdate {
  id           String       @id @default(cuid())
  title        String
  content      String
  type         String       @default("CUSTOM")
  imageUrl     String?
  isActive     Boolean      @default(true)
  priority     Int          @default(0)
  showDelay    Int          @default(0)
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  ctaLink      String?
  ctaText      String?
  courseIds    String       @default("")
  frequency    String       @default("ONCE")
  intervalDays Int          @default(0)
  animation    String?
  endDate      DateTime?
  startDate    DateTime?
  createdBy    User         @relation("UpdateCreator", fields: [createdById], references: [id])
  views        UpdateView[]

  @@index([type])
  @@index([isActive])
  @@index([createdById])
}

model UpdateView {
  id       String       @id @default(cuid())
  updateId String
  userId   String
  viewedAt DateTime     @default(now())
  update   SystemUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([updateId, userId])
  @@index([userId])
}

model UpdateSystemSettings {
  id              String  @id @default("singleton")
  welcomeEnabled  Boolean @default(true)
  customEnabled   Boolean @default(true)
  maintenanceMode Boolean @default(false)
}

model HelpCardConfig {
  id          String  @id @default("singleton")
  title       String  @default("Need Help?")
  description String  @default("")
  buttonText  String  @default("Enroll in More")
  redirectUrl String  @default("mailto:support@example.com")
  isEnabled   Boolean @default(true)
}

model ExamCountdown {
  id             String    @id @default(cuid())
  title          String    @default("Upcoming Exam")
  deadlineDate   DateTime? // When the countdown ends (calculated from deadline date at 12:01 AM IST)
  updatedAt      DateTime  @updatedAt
}

model Feedback {
  id             String   @id @default(cuid())
  studentId      String
  courseId       String   @map("classId")
  teacherRating  Int
  conceptRating  Int
  materialRating Int
  recommendScore Int
  comment        String?
  createdAt      DateTime @default(now())
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model SyncQueue {
  id        String   @id @default(cuid())
  userId    String
  processAt DateTime
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([processed])
  @@index([processAt])
}

model GroupSyncJob {
  id           String   @id @default(cuid())
  userEmail    String
  courseId     String   @map("classId")
  groupEmail   String
  action       String
  status       String   @default("PENDING")
  attemptCount Int      @default(0)
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([status, attemptCount])
  @@index([courseId])
  @@index([userEmail])
  @@index([createdAt])
}

model GroupSyncLock {
  id            String   @id @default("singleton")
  isProcessing  Boolean  @default(false)
  lockedAt      DateTime?
  updatedAt     DateTime @updatedAt
}

// ─── Analytics (Precomputed, Read-Only by Frontend) ──────────────────────

model AnalyticsSnapshot {
  id                  String   @id @default(cuid())
  date                DateTime @unique           // The day this snapshot covers (date only, no time)
  totalUsers          Int      @default(0)       // Total STUDENT users at time of snapshot
  newUsers            Int      @default(0)       // Users where User.createdAt falls on this day
  returningUsers      Int      @default(0)       // Active users whose createdAt is before this day
  activeUsers         Int      @default(0)       // Unique users in ActivityLog on this day
  totalEnrollments    Int      @default(0)       // Enrollments created on this day
  avgCoursesPerStudent Float   @default(0)       // Total enrollments / total students
  hourlyActivity      String?                    // JSON: {"0":5,"1":2,...,"23":10}
  topCourses          String?                    // JSON: [{"courseId":"x","name":"Y","count":50},...]
  courseDistribution  String?                    // JSON: [{"courseId":"x","name":"Y","count":50},...]
  demographics        String?                    // JSON: Demographic breakdown of audiences
  createdAt           DateTime @default(now())

  @@index([date])
}

model AnalyticsCourseDaily {
  id               String   @id @default(cuid())
  date             DateTime                      // The day
  courseId          String                        // Course ID (not a FK — read-only snapshot)
  courseName       String                        // Denormalized for fast reads
  enrollmentCount  Int      @default(0)          // Enrollments on this day for this course
  totalEnrollments Int      @default(0)          // Cumulative enrollments for this course
  growthDelta      Int      @default(0)          // Today's enrollments minus yesterday's
  createdAt        DateTime @default(now())

  @@unique([date, courseId])
  @@index([date])
  @@index([courseId])
}

model AnalyticsConfig {
  id                 String   @id @default("singleton")
  lastUpdatedAt      DateTime @default(now())    // When the cron last ran successfully
  cronIntervalHours  Int      @default(24)       // Used by frontend to compute next update time
}

model LectureProgress {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  status    String   @default("NOT_STARTED")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}
model LectureProgressQueue {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  status    String
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([processed])
  @@index([userId])
}

model CommunityReadState {
  id         String   @id @default(cuid())
  userId     String
  courseId    String   @map("classId")
  lastReadAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}
