generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           String   @default("STUDENT")
  avatar         String?
  gender         String?  @default("MALE")
  securityNumber String?  @unique
  isTerminated   Boolean  @default(false)
  canTerminate   Boolean  @default(false)
  canCreateStudents Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdCourses        Course[]               @relation("CourseCreator")
  uploadedLectures      Lecture[]              @relation("LectureUploader")
  uploadedMaterials     Material[]             @relation("MaterialUploader")
  createdSessions       LiveSession[]          @relation("SessionCreator")
  createdEvents         CalendarEvent[]        @relation("EventCreator")
  instructorEvents      CalendarEvent[]        @relation("EventInstructor")
  enrollments           Enrollment[]
  instructorAssignments InstructorAssignment[]
  supportTickets        SupportTicket[]        @relation("TicketStudent")
  assignedTickets       SupportTicket[]        @relation("TicketAssignee")
  ticketReplies         TicketReply[]          @relation("ReplyAuthor")
  chatSessions          ChatSession[]          @relation("ChatStudent")
  agentSessions         ChatSession[]          @relation("ChatAgent")
  chatMessages          ChatMessage[]          @relation("ChatMsgSender")
  communityMessages     CommunityMessage[]     @relation("CommMsgSender")
  notifications         Notification[]
  announcements         Announcement[]         @relation("AnnouncementCreator")
  activityLogs          ActivityLog[]
  loginLogs             LoginLog[]
}

model Course {
  id          String   @id @default(cuid())
  name        String
  description String?
  subject     String?
  color       String   @default("#4F46E5")
  icon        String   @default("BookOpen")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy             User                   @relation("CourseCreator", fields: [createdById], references: [id])
  lectures              Lecture[]
  liveSessions          LiveSession[]
  materials             Material[]
  events                CalendarEvent[]
  topics                Topic[]
  enrollments           Enrollment[]
  instructorAssignments InstructorAssignment[]
  supportTickets        SupportTicket[]
  communityMessages     CommunityMessage[]
  announcements         Announcement[]
  exams                 Exam[]
  expiresAt             DateTime?

  @@map("Class")
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String   @map("classId")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Lecture {
  id           String   @id @default(cuid())
  courseId     String   @map("classId")
  title        String
  description  String?
  videoUrl     String?
  notesUrl     String?
  duration     String?
  thumbnail    String?
  uploadedById String
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("LectureUploader", fields: [uploadedById], references: [id])
}

model LiveSession {
  id          String   @id @default(cuid())
  courseId    String   @map("classId")
  title       String
  description String?
  meetingLink String
  instructor  String
  date        String
  time        String
  status      String   @default("scheduled")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy User   @relation("SessionCreator", fields: [createdById], references: [id])
}

model Material {
  id           String   @id @default(cuid())
  courseId     String   @map("classId")
  title        String
  description  String?
  fileUrl      String
  fileType     String
  fileSize     String?
  uploadedById String
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("MaterialUploader", fields: [uploadedById], references: [id])
}

model CalendarEvent {
  id            String   @id @default(cuid())
  title         String
  description   String?
  date          String
  time          String?
  type          String   @default("course")
  relatedCourse String?  @map("relatedClass")
  courseId      String?  @map("classId")
  createdById   String
  instructorId  String?
  meetingLink   String?
  status        String   @default("scheduled")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course     Course? @relation(fields: [courseId], references: [id])
  createdBy  User    @relation("EventCreator", fields: [createdById], references: [id])
  instructor User?   @relation("EventInstructor", fields: [instructorId], references: [id])
}

model Topic {
  id        String   @id @default(cuid())
  courseId  String   @map("classId")
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  content Content[]
}

model Content {
  id          String   @id @default(cuid())
  topicId     String
  title       String
  description String?
  videoUrl    String?
  videoSource String   @default("YOUTUBE")
  pptUrl      String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  type        String   @default("info")
  courseId    String?  @map("classId")
  pollId      String?  @unique
  imageUrl    String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course? @relation(fields: [courseId], references: [id])
  createdBy User    @relation("AnnouncementCreator", fields: [createdById], references: [id])
  poll      Poll?   @relation(fields: [pollId], references: [id])
}

model Poll {
  id                String    @id @default(cuid())
  question          String
  expiresAt         DateTime
  createdById       String
  cachedResults     String?   // JSON stringified results
  lastResultsUpdate DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  announcement Announcement?
  options      PollOption[]
  responses    PollResponse[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  text   String
  order  Int    @default(0)

  poll      Poll           @relation(fields: [pollId], references: [id], onDelete: Cascade)
  responses PollResponse[]
}

model PollResponse {
  id       String   @id @default(cuid())
  pollId   String
  optionId String
  userId   String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model Exam {
  id              String   @id @default(cuid())
  title           String
  description     String?
  courseId        String   @map("classId")
  expiresAt       DateTime
  startDate       DateTime?
  durationMinutes Int
  isPublished     Boolean  @default(false)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions ExamQuestion[]
  attempts  ExamAttempt[]
}

model ExamQuestion {
  id            String   @id @default(cuid())
  examId        String
  text          String
  type          String   // MCQ, SHORT, LONG, FILL
  options       String?  // JSON array for MCQs
  correctAnswer String?
  explanation   String?
  imageUrl      String?
  questionBankId String?
  marks         Int      @default(1)
  order         Int      @default(0)

  exam      Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  responses ExamResponse[]
}

model ExamAttempt {
  id           String    @id @default(cuid())
  examId       String
  userId       String
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  totalMarks   Float?
  isEvaluated  Boolean   @default(false)
  isPublished  Boolean   @default(false)
  feedback     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  exam      Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  responses ExamResponse[]

  @@unique([examId, userId])
}

model ExamResponse {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  answer     String
  marks      Float?
  feedback   String?

  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id           String   @id @default(cuid())
  title        String
  description  String
  type         String   @default("GENERAL")
  status       String   @default("OPEN")
  priority     String   @default("MEDIUM")
  studentId    String
  courseId     String?  @map("classId")
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course     Course?       @relation(fields: [courseId], references: [id])
  user       User          @relation("TicketStudent", fields: [studentId], references: [id])
  assignedTo User?         @relation("TicketAssignee", fields: [assignedToId], references: [id])
  replies    TicketReply[]
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation("ReplyAuthor", fields: [senderId], references: [id])
}

model ChatSession {
  id        String    @id @default(cuid())
  studentId String
  agentId   String?
  status    String    @default("WAITING")
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  student  User          @relation("ChatStudent", fields: [studentId], references: [id])
  agent    User?         @relation("ChatAgent", fields: [agentId], references: [id])
  messages ChatMessage[]
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  content         String
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  isSystemDeleted Boolean   @default(false)
  createdAt       DateTime  @default(now())

  chat   ChatSession @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User        @relation("ChatMsgSender", fields: [senderId], references: [id])
}

model CommunityMessage {
  id        String    @id @default(cuid())
  courseId  String    @map("classId")
  senderId  String
  content         String
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  isSystemDeleted Boolean   @default(false)
  createdAt       DateTime  @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sender User   @relation("CommMsgSender", fields: [senderId], references: [id])
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  title          String
  content        String
  type           String   @default("INFO")
  isRead         Boolean  @default(false)
  announcementId String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id                String   @id @default(cuid())
  userId            String
  userName          String
  userRole          String
  securityNumber    String?
  actionType        String
  actionDescription String
  moduleName        String
  targetId          String?
  metadata          String?
  timestamp         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InstructorAssignment {
  id           String   @id @default(cuid())
  instructorId String
  courseId     String   @map("classId")
  assignedAt   DateTime @default(now())

  instructor User   @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([instructorId, courseId])
}

model QuestionBank {
  id            String   @id @default(cuid())
  subject       String
  text          String
  type          String
  options       String?  // JSON array
  correctAnswer String?
  explanation   String?
  imageUrl      String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([subject])
}
