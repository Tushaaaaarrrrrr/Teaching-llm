generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                 @id @default(cuid())
  name                    String
  email                   String                 @unique
  passwordHash            String
  role                    String                 @default("STUDENT")
  avatar                  String?
  securityNumber          String?                @unique
  isTerminated            Boolean                @default(false)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  canCreateStudents       Boolean                @default(false)
  canTerminate            Boolean                @default(false)
  isSuperManager          Boolean                @default(false)
  encryptedTempPassword   String?
  gender                  String?                @default("MALE")
  hasSeenWelcome          Boolean                @default(false)
  lastSeenCommunityAt     DateTime?
  lastSeenSupportAt       DateTime?
  lastSeenNotificationsAt DateTime?
  tokenVersion            Int                    @default(0)
  violationCount          Int                    @default(0)
  blockedUntil            DateTime?
  lastViolationAt         DateTime?
  activityLogs            ActivityLog[]
  announcements           Announcement[]         @relation("AnnouncementCreator")
  chatMessages            ChatMessage[]          @relation("ChatMsgSender")
  chatSessions            ChatSession[]          @relation("ChatStudent")
  agentSessions           ChatSession[]          @relation("ChatAgent")
  createdCourses          Course[]               @relation("CourseCreator")
  communityMessages       CommunityMessage[]     @relation("CommMsgSender")
  courseEvents            CourseEvent[]          @relation("EventCreator")
  instructorCourseEvents  CourseEvent[]          @relation("EventInstructor")
  enrollments             Enrollment[]
  googleCredential        GoogleCredential?
  instructorAssignments   InstructorAssignment[]
  uploadedLectures        Lecture[]              @relation("LectureUploader")
  loginLogs               LoginLog[]
  uploadedMaterials       Material[]             @relation("MaterialUploader")
  notifications           Notification[]
  supportTickets          SupportTicket[]        @relation("TicketStudent")
  assignedTickets         SupportTicket[]        @relation("TicketAssignee")
  ticketReplies           TicketReply[]          @relation("ReplyAuthor")
}

model Course {
  id                    String                 @id @default(cuid())
  name                  String
  description           String?
  subject               String?
  color                 String                 @default("#4F46E5")
  icon                  String                 @default("BookOpen")
  createdById           String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  expiresAt             DateTime?
  isDemo                Boolean                @default(false)
  isGlobal              Boolean                @default(false)
  isCommunityActive     Boolean                @default(true)
  teacherName           String?
  googleDriveFolderId   String?
  announcements         Announcement[]
  createdBy             User                   @relation("CourseCreator", fields: [createdById], references: [id])
  communityMessages     CommunityMessage[]
  courseEvents          CourseEvent[]
  enrollments           Enrollment[]
  exams                 Exam[]
  instructorAssignments InstructorAssignment[]
  lectures              Lecture[]
  materials             Material[]
  supportTickets        SupportTicket[]
  topics                Topic[]

  @@map("Class")
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String   @map("classId")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Lecture {
  id           String   @id @default(cuid())
  courseId     String   @map("classId")
  title        String
  description  String?
  videoUrl     String?
  notesUrl     String?
  duration     String?
  thumbnail    String?
  uploadedById String
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  uploadedBy   User     @relation("LectureUploader", fields: [uploadedById], references: [id])
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([uploadedById])
}

model Material {
  id           String   @id @default(cuid())
  courseId     String   @map("classId")
  title        String
  description  String?
  fileUrl      String
  fileType     String
  fileSize     String?
  uploadedById String
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  uploadedBy   User     @relation("MaterialUploader", fields: [uploadedById], references: [id])
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([uploadedById])
}

model CourseEvent {
  id            String   @id @default(cuid())
  googleEventId String?  @unique
  courseId      String?  @map("classId")
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  meetLink      String?
  manualStatus  String   @default("NONE")
  type          String   @default("class")
  instructorId  String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     User     @relation("EventCreator", fields: [createdById], references: [id])
  instructor    User?    @relation("EventInstructor", fields: [instructorId], references: [id])
  course        Course?  @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@index([startTime])
  @@index([createdById])
  @@index([instructorId])
  @@index([type])
}

model GoogleCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  calendarId   String   @default("primary")
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Topic {
  id        String    @id @default(cuid())
  courseId  String    @map("classId")
  title     String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  content   Content[]
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Content {
  id          String   @id @default(cuid())
  topicId     String
  title       String
  description String?
  videoUrl    String?
  pptUrl      String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  videoSource String   @default("YOUTUBE")
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  type        String   @default("info")
  courseId    String?  @map("classId")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String?
  pollId      String?  @unique
  poll        Poll?    @relation(fields: [pollId], references: [id])
  createdBy   User     @relation("AnnouncementCreator", fields: [createdById], references: [id])
  course      Course?  @relation(fields: [courseId], references: [id])
}

model Poll {
  id                String         @id @default(cuid())
  question          String
  expiresAt         DateTime
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  cachedResults     String?
  lastResultsUpdate DateTime?
  announcement      Announcement?
  options           PollOption[]
  responses         PollResponse[]
}

model PollOption {
  id        String         @id @default(cuid())
  pollId    String
  text      String
  order     Int            @default(0)
  poll      Poll           @relation(fields: [pollId], references: [id], onDelete: Cascade)
  responses PollResponse[]
}

model PollResponse {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime   @default(now())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model Exam {
  id              String         @id @default(cuid())
  title           String
  description     String?
  courseId        String         @map("classId")
  expiresAt       DateTime
  durationMinutes Int
  isPublished     Boolean        @default(false)
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  startDate       DateTime?
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts        ExamAttempt[]
  questions       ExamQuestion[]

  @@index([courseId])
}

model ExamQuestion {
  id             String         @id @default(cuid())
  examId         String
  text           String
  type           String
  options        String?
  correctAnswer  String?
  explanation    String?
  marks          Int            @default(1)
  order          Int            @default(0)
  imageUrl       String?
  questionBankId String?
  exam           Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  responses      ExamResponse[]
}

model ExamAttempt {
  id          String         @id @default(cuid())
  examId      String
  userId      String
  startedAt   DateTime       @default(now())
  submittedAt DateTime?
  totalMarks  Float?
  isEvaluated Boolean        @default(false)
  feedback    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  isPublished Boolean        @default(false)
  exam        Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  responses   ExamResponse[]

  @@unique([examId, userId])
}

model ExamResponse {
  id         String       @id @default(cuid())
  attemptId  String
  questionId String
  answer     String
  marks      Float?
  feedback   String?
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempt    ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id           String        @id @default(cuid())
  title        String
  description  String
  type         String        @default("GENERAL")
  status       String        @default("OPEN")
  priority     String        @default("MEDIUM")
  studentId    String
  courseId     String?       @map("classId")
  assignedToId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation("TicketStudent", fields: [studentId], references: [id])
  course       Course?       @relation(fields: [courseId], references: [id])
  assignedTo   User?         @relation("TicketAssignee", fields: [assignedToId], references: [id])
  replies      TicketReply[]

  @@index([courseId])
  @@index([studentId])
}

model TicketReply {
  id        String        @id @default(cuid())
  ticketId  String
  senderId  String
  content   String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User          @relation("ReplyAuthor", fields: [senderId], references: [id])
}

model ChatSession {
  id        String        @id @default(cuid())
  studentId String
  agentId   String?
  status    String        @default("WAITING")
  expiresAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  student   User          @relation("ChatStudent", fields: [studentId], references: [id])
  agent     User?         @relation("ChatAgent", fields: [agentId], references: [id])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id              String      @id @default(cuid())
  chatId          String
  senderId        String
  content         String
  createdAt       DateTime    @default(now())
  deletedAt       DateTime?
  isDeleted       Boolean     @default(false)
  isSystemDeleted Boolean     @default(false)
  sender          User        @relation("ChatMsgSender", fields: [senderId], references: [id])
  chat            ChatSession @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model CommunityMessage {
  id              String    @id @default(cuid())
  courseId        String    @map("classId")
  senderId        String
  content         String
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  isSystemDeleted Boolean   @default(false)
  sender          User      @relation("CommMsgSender", fields: [senderId], references: [id])
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([senderId])
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  title          String
  content        String
  type           String   @default("INFO")
  isRead         Boolean  @default(false)
  announcementId String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id                String   @id @default(cuid())
  userId            String
  userName          String
  userRole          String
  securityNumber    String?
  actionType        String
  actionDescription String
  moduleName        String
  targetId          String?
  metadata          String?
  timestamp         DateTime @default(now())
  priority          Int      @default(0) // 0: LOW, 1: MEDIUM, 2: HIGH
  isFailure         Boolean  @default(false)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
}

model InstructorAssignment {
  id           String   @id @default(cuid())
  instructorId String
  courseId     String   @map("classId")
  assignedAt   DateTime @default(now())
  instructor   User     @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([instructorId, courseId])
}

model QuestionBank {
  id            String   @id @default(cuid())
  subject       String
  text          String
  type          String
  options       String?
  correctAnswer String?
  explanation   String?
  imageUrl      String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([subject])
}
