generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           String   @default("STUDENT")
  avatar         String?
  securityNumber String?  @unique
  isTerminated   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdClasses        Class[]                @relation("ClassCreator")
  uploadedLectures      Lecture[]              @relation("LectureUploader")
  uploadedMaterials     Material[]             @relation("MaterialUploader")
  createdSessions       LiveSession[]          @relation("SessionCreator")
  createdEvents         CalendarEvent[]        @relation("EventCreator")
  instructorEvents      CalendarEvent[]        @relation("EventInstructor")
  enrollments           Enrollment[]
  instructorAssignments InstructorAssignment[]
  supportTickets        SupportTicket[]        @relation("TicketStudent")
  assignedTickets       SupportTicket[]        @relation("TicketAssignee")
  ticketReplies         TicketReply[]          @relation("ReplyAuthor")
  chatSessions          ChatSession[]          @relation("ChatStudent")
  agentSessions         ChatSession[]          @relation("ChatAgent")
  chatMessages          ChatMessage[]          @relation("ChatMsgSender")
  communityMessages     CommunityMessage[]     @relation("CommMsgSender")
  notifications         Notification[]
  announcements         Announcement[]         @relation("AnnouncementCreator")
  activityLogs          ActivityLog[]
}

model Class {
  id          String   @id @default(cuid())
  name        String
  description String?
  subject     String?
  color       String   @default("#4F46E5")
  icon        String   @default("BookOpen")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy             User                   @relation("ClassCreator", fields: [createdById], references: [id])
  lectures              Lecture[]
  liveSessions          LiveSession[]
  materials             Material[]
  events                CalendarEvent[]
  topics                Topic[]
  enrollments           Enrollment[]
  instructorAssignments InstructorAssignment[]
  supportTickets        SupportTicket[]
  communityMessages     CommunityMessage[]
  announcements         Announcement[]
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  classId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, classId])
}

model Lecture {
  id           String   @id @default(cuid())
  classId      String
  title        String
  description  String?
  videoUrl     String?
  notesUrl     String?
  duration     String?
  thumbnail    String?
  uploadedById String
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  class      Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation("LectureUploader", fields: [uploadedById], references: [id])
}

model LiveSession {
  id          String   @id @default(cuid())
  classId     String
  title       String
  description String?
  meetingLink String
  instructor  String
  date        String
  time        String
  status      String   @default("scheduled")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class     Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy User  @relation("SessionCreator", fields: [createdById], references: [id])
}

model Material {
  id           String   @id @default(cuid())
  classId      String
  title        String
  description  String?
  fileUrl      String
  fileType     String
  fileSize     String?
  uploadedById String
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  class      Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation("MaterialUploader", fields: [uploadedById], references: [id])
}

model CalendarEvent {
  id           String   @id @default(cuid())
  title        String
  description  String?
  date         String
  time         String?
  type         String   @default("class")
  relatedClass String?
  classId      String?
  createdById  String
  instructorId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  class      Class? @relation(fields: [classId], references: [id])
  createdBy  User   @relation("EventCreator", fields: [createdById], references: [id])
  instructor User?  @relation("EventInstructor", fields: [instructorId], references: [id])
}

model Topic {
  id        String   @id @default(cuid())
  classId   String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  content Content[]
}

model Content {
  id          String   @id @default(cuid())
  topicId     String
  title       String
  description String?
  videoUrl    String?
  pptUrl      String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  type        String   @default("info")
  classId     String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class     Class? @relation(fields: [classId], references: [id])
  createdBy User   @relation("AnnouncementCreator", fields: [createdById], references: [id])
}

model SupportTicket {
  id           String   @id @default(cuid())
  title        String
  description  String
  type         String   @default("GENERAL")
  status       String   @default("OPEN")
  priority     String   @default("MEDIUM")
  studentId    String
  classId      String?
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  class      Class?        @relation(fields: [classId], references: [id])
  user       User          @relation("TicketStudent", fields: [studentId], references: [id])
  assignedTo User?         @relation("TicketAssignee", fields: [assignedToId], references: [id])
  replies    TicketReply[]
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation("ReplyAuthor", fields: [senderId], references: [id])
}

model ChatSession {
  id        String    @id @default(cuid())
  studentId String
  agentId   String?
  status    String    @default("WAITING")
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  student  User          @relation("ChatStudent", fields: [studentId], references: [id])
  agent    User?         @relation("ChatAgent", fields: [agentId], references: [id])
  messages ChatMessage[]
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  chat   ChatSession @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User        @relation("ChatMsgSender", fields: [senderId], references: [id])
}

model CommunityMessage {
  id        String    @id @default(cuid())
  classId   String
  senderId  String
  content   String
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  class  Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  sender User  @relation("CommMsgSender", fields: [senderId], references: [id])
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  title          String
  content        String
  type           String   @default("INFO")
  isRead         Boolean  @default(false)
  announcementId String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id                String   @id @default(cuid())
  userId            String
  userName          String
  userRole          String
  securityNumber    String?
  actionType        String
  actionDescription String
  moduleName        String
  targetId          String?
  metadata          String?
  timestamp         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InstructorAssignment {
  id           String   @id @default(cuid())
  instructorId String
  classId      String
  assignedAt   DateTime @default(now())

  instructor User  @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  class      Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([instructorId, classId])
}
